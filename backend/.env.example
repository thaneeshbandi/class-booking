# Class Booking — backend environment
#
# Copy to backend/.env and fill in. `.env` is gitignored and must never be
# committed; every value below is supplied as a real environment variable in
# deployed environments (Render, Supabase, CI).
#
# Every variable here is validated with Zod at startup (src/config/env.js), so
# a missing or malformed value fails immediately and identically for the
# server, the migration runner, the seed runner and the tests.

# --- required ---------------------------------------------------------------

# development | test | production
NODE_ENV=development

# PostgreSQL connection string.
# Local Docker container:
#   docker run -d --name class-booking-pg \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=class_booking \
#     -p 5432:5432 postgres:17
DATABASE_URL=postgres://postgres:postgres@localhost:5432/class_booking

# The wall-clock zone the studio operates in, as an IANA name.
# Load-bearing, not cosmetic: the database stores instants only, and every
# civil-day boundary ("sessions today", "no-shows this week", the seven-day
# membership alert window) is computed from this. A wrong value shifts those
# boundaries silently, so it is validated against the IANA database at startup
# and has no default.
STUDIO_TIMEZONE=Europe/London

# --- optional ---------------------------------------------------------------

PORT=3000

# Set to true for managed Postgres whose certificate is not in Node's trust
# store (Supabase, Render). Left false for a local container so a local
# connection is never silently downgraded to an unverified TLS session.
DATABASE_SSL=false

# The least-privileged role the application connects as in a deployed
# environment. When set, migrations grant it table privileges and revoke
# UPDATE/DELETE/TRUNCATE on booking_events.
#
# This only means anything if migrations run as a DIFFERENT role that owns the
# tables: an owner keeps its privileges no matter what is revoked, and a
# superuser bypasses privilege checks entirely. Unset (typical local setup,
# where one role does everything) the grants are skipped and the append-only
# trigger is the sole enforcement — the trigger applies to every role, so
# history immutability never depends on this being configured.
# APP_DB_ROLE=class_booking_app

# --- required (auth) --------------------------------------------------------

# Signs the session cookie's HMAC token. Minimum 32 characters, required.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- seeding ----------------------------------------------------------------

# Password given to every seeded demo account. Deliberately has no default, so
# no password literal is ever committed; `npm run db:seed` fails without it.
# The value used for the deployed demo is recorded in SUBMISSION.md, not here.
SEED_PASSWORD=

# --- tests ------------------------------------------------------------------

# Optional. A connection string for APP_DB_ROLE, used by the schema test suite
# to prove the booking_events grants reject UPDATE with a privilege error
# (42501) rather than relying on the trigger. Skipped when unset.
# APP_DB_URL=postgres://class_booking_app:...@localhost:5432/class_booking
