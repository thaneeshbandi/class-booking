{
  "name": "class-booking-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Class Booking \u2014 backend database foundation",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/db.js migrate",
    "db:rollback": "node scripts/db.js rollback",
    "db:status": "node scripts/db.js status",
    "db:seed": "node scripts/db.js seed",
    "db:reset": "node scripts/db.js reset",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.17.0"
  }
}
