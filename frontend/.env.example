# Class Booking — frontend environment
#
# Copy to frontend/.env.local (gitignored) for local overrides. Vite only
# exposes variables prefixed VITE_ to browser code — nothing else in
# process.env leaks into the built bundle.

# The backend's own origin. No trailing slash. Must match a backend
# configured with the matching FRONTEND_ORIGIN so CORS allows it.
VITE_API_BASE_URL=http://localhost:3000
